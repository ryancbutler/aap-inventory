{
  "name": "Cluster survey",
  "description": "Answers are passed to playbook.yml as extra vars",
  "spec": [
    {
      "question_name": "Cluster name",
      "question_description": "Exact cluster name, e.g. atlas",
      "variable": "cluster_name",
      "type": "text",
      "default": "",
      "required": true,
      "min": 1,
      "max": 100
    },
    {
      "question_name": "Which hosts in the cluster?",
      "variable": "target_group",
      "type": "multiplechoice",
      "choices": "all\nfrontend\napp\ndb",
      "default": "all",
      "required": false
    },
    {
      "question_name": "Seconds to wait for hosts to accept connections",
      "question_description": "Raise this if newly built VMs take longer to boot",
      "variable": "connect_timeout",
      "type": "integer",
      "default": 300,
      "min": 1,
      "max": 3600,
      "required": false
    }
  ]
}
