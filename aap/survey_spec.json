{
  "name": "Demo survey",
  "description": "Answers are passed to playbook.yml as extra vars",
  "spec": [
    {
      "question_name": "Which group should the job run against?",
      "variable": "target_group",
      "type": "multiplechoice",
      "choices": "all\nweb\ndb",
      "default": "all",
      "required": true
    },
    {
      "question_name": "Greeting to print",
      "variable": "greeting",
      "type": "text",
      "default": "Hello from AAP",
      "required": false,
      "min": 0,
      "max": 100
    },
    {
      "question_name": "Value to export as $DEMO_TARGET_ENV for tasks",
      "variable": "target_env",
      "type": "multiplechoice",
      "choices": "dev\nprod",
      "default": "dev",
      "required": true
    }
  ]
}
